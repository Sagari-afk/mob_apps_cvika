<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_200"
    android:orientation="vertical"
    android:padding="16dp">

    <Spinner
        android:id="@+id/spCountryOrigin"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        android:entries="@array/country_origin" />

    <Button
        android:id="@+id/btnFindBeer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/violet"
        android:text="@string/find_beer"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/no_beer"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnFindVine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/pink_amaranth"
        android:text="@string/find_vine"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/reportVine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center"
        android:text="@string/no_vine"
        android:textColor="#FFFFFF" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/vine_or_beer_photo"
        android:src="@drawable/none" />
</LinearLayout>

