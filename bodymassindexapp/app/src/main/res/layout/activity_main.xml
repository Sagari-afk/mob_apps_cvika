<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Switch
        android:id="@+id/pohlavie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Muz/zena"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/vyska"
        app:layout_constraintEnd_toEndOf="@+id/vyska"
        app:layout_constraintStart_toStartOf="@+id/vyska"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Button
        android:id="@+id/vypocitajBMI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vypocitaj BMI"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/vypocitane"
        app:layout_constraintEnd_toEndOf="@+id/vypocitane"
        app:layout_constraintStart_toStartOf="@+id/vypocitane"
        app:layout_constraintTop_toBottomOf="@+id/vaha" />

    <EditText
        android:id="@+id/vyska"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:ems="10"
        android:inputType="number"
        android:text=""
        android:textSize="34sp"
        android:maxLength="3"
        app:layout_constraintBottom_toTopOf="@+id/vaha"
        app:layout_constraintEnd_toEndOf="@+id/vaha"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="@+id/vaha"
        app:layout_constraintTop_toBottomOf="@+id/pohlavie"
        tools:ignore="LabelFor" />

    <EditText
        android:id="@+id/vaha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:ems="10"
        android:inputType="number"
        android:text=""
        android:maxLength="3"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/vypocitajBMI"
        app:layout_constraintEnd_toEndOf="@+id/vypocitajBMI"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="@+id/vypocitajBMI"
        app:layout_constraintTop_toBottomOf="@+id/vyska"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/vypocitane"
        android:layout_width="356dp"
        android:layout_height="49dp"
        android:text="Vypocitane BMI"
        android:textAlignment="center"
        android:textSize="34sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/summary"
        app:layout_constraintEnd_toEndOf="@+id/summary"
        app:layout_constraintHorizontal_bias="0.478"
        app:layout_constraintStart_toStartOf="@+id/summary"
        app:layout_constraintTop_toBottomOf="@+id/vypocitajBMI" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="375dp"
        android:layout_height="117dp"
        android:text="TextView"
        android:textAlignment="center"
        android:textSize="34sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vypocitane" />

</androidx.constraintlayout.widget.ConstraintLayout>