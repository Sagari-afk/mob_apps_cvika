<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graf"
    app:startDestination="@id/zoznamAutorov">

    <fragment
        android:id="@+id/zoznamAutorov"
        android:name="com.example.fragmentyautori.ZoznamAutorovFragment"
        android:label="fragment_zoznam_autorov"
        tools:layout="@layout/fragment_zoznam_autorov" >
        <action
            android:id="@+id/action_zoznamAutorov_to_autorFragment"
            app:destination="@id/autorFragment" />
    </fragment>

    <fragment
        android:id="@+id/autorFragment"
        android:name="com.example.fragmentyautori.AutorFragment"
        android:label="fragment_autor"
        tools:layout="@layout/fragment_autor" >
        <argument
            android:name="autorName"
            app:argType="string" />
    </fragment>

</navigation>