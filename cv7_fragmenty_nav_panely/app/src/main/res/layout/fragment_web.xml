<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".WebFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/web"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/web_text"
        android:textAlignment="center" />

    <Switch
        android:id="@+id/switch_custom"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="@string/custom_url"
        android:textAlignment="center"
        android:layout_gravity="center"/>

    <Spinner
        android:id="@+id/urls"
        android:layout_width="306dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:entries="@array/predvolene_urls_list"
        android:spinnerMode="dropdown"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/editUrl"
        android:layout_width="306dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:text="@string/tu_zadaj_custom_url"
        tools:visibility="gone" />

    <Button
        android:id="@+id/otvor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/otvorit_web" />


</LinearLayout>